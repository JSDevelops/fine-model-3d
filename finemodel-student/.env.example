# Firebase Configuration Template for FINEVERSE Student App
# Rename this file to .env and fill in your Firebase project credentials.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Gemini API Configuration (Optional: Used for AI Object Scanner)
# Retrieve your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key

